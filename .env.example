# Elastic Stack Version
ELASTIC_VERSION=8.19.4

# Target Credentials (auto-generated by configure.py if left as CHANGE_ME)
LAB_PASSWORD=CHANGE_ME
WINDOWS_USER=labadmin
WINDOWS_PASSWORD=CHANGE_ME

# Windows Guest Resource Allocation
WINDOWS_RAM=4G
WINDOWS_CPUS=2
WINDOWS_DISK=64G
WINDOWS_TIMEOUT=7200

# Base Images
DOCKUR_IMAGE=dockurr/windows:latest
